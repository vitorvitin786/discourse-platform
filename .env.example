# Database
DATABASE_URL=postgresql://discourse:discourse_dev@localhost:5432/discourse

# Redis
REDIS_URL=redis://localhost:6379

# Server
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# JWT
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_change_this_in_production

# OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# S3/Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=discourse
S3_REGION=us-east-1

# Email (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@discourse.local

# Monitoring (optional)
SENTRY_DSN=
LOG_LEVEL=info

# Feature Flags
FEATURE_AI_ASSISTANT=false
FEATURE_BOTS=true
FEATURE_INTEGRATIONS=false
